{
  "expo": {
    "name": "Turnify Pro",
    "slug": "turnify-pro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0D1B3A",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B3A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.turnifypro.mobile"
    },
    "android": {
      "package": "com.turnifypro.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0D1B3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Turnify usa el micrófono para que puedas hablar con el asistente virtual TURNITY."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "596fecfb-289d-492d-97df-18d1aa308a9d"
      }
    },
    "owner": "turnify-pro"
  }
}
