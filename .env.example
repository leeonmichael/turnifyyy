# Copia este archivo como ".env" y completa tus propios valores.
# Nunca subas el archivo ".env" real al repositorio.

# API key gratuita de Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Bucket de Firebase Storage para documentos de turnos virtuales.
# Se ve en Firebase Console -> Storage (activa Storage ahí si nunca lo usaste).
# Si se deja vacío, se intenta "<project_id>.appspot.com" por defecto.
FIREBASE_STORAGE_BUCKET=
