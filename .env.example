# Copia este archivo como ".env" y completa tus propios valores.
# Nunca subas el archivo ".env" real al repositorio.

# API key gratuita de Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Secreto para firmar los tokens de sesión (JWT). Genera uno propio con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Supabase Storage: reemplaza a Firebase Storage para documentos e imágenes
# de turnos virtuales. Se ve en Supabase -> Project Settings -> API.
# SUPABASE_SERVICE_ROLE_KEY es secreta (bypassa RLS): nunca la subas ni la
# expongas al frontend, solo se usa desde el backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
